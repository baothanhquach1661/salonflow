@model SalonFlow.Web.Models.CreateAppointmentViewModel

@{
    ViewData["Title"] = "New Appointment";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <p class="text-primary fw-semibold mb-1">APPOINTMENTS</p>
                <h1 class="h2 fw-bold mb-1">New Appointment</h1>
                <p class="text-secondary mb-0">
                    Schedule a service for a customer.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>
        </div>

        @if (Model.CreatedAppointmentId.HasValue)
        {
            <div class="alert alert-success">
                <h2 class="h5">Appointment created successfully</h2>

                <p class="mb-1">
                    ID: <strong>@Model.CreatedAppointmentId</strong>
                </p>

                <p class="mb-1">
                    Status: <strong>@Model.CreatedStatus</strong>
                </p>

                <p class="mb-0">
                    UTC time: @Model.StartsAtUtc → @Model.EndsAtUtc
                </p>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Appointments" asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label"></label>

                            <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />

                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>

                            <input asp-for="PhoneNumber" class="form-control" placeholder="(555) 555-5555" />

                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ServiceName" class="form-label"></label>

                            <select asp-for="ServiceName" class="form-select">
                                <option value="">Select a service</option>
                                <option value="Haircut">Haircut</option>
                                <option value="Hair Coloring">Hair Coloring</option>
                                <option value="Manicure">Manicure</option>
                                <option value="Pedicure">Pedicure</option>
                            </select>

                            <span asp-validation-for="ServiceName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StaffMemberName" class="form-label"></label>

                            <select asp-for="StaffMemberName" class="form-select">
                                <option value="">Any available staff</option>
                                <option value="Staff Member 1">Staff Member 1</option>
                                <option value="Staff Member 2">Staff Member 2</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartsAtLocal" class="form-label"></label>

                            <input asp-for="StartsAtLocal" type="datetime-local" class="form-control" />

                            <span asp-validation-for="StartsAtLocal" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="DurationMinutes" class="form-label"></label>

                            <select asp-for="DurationMinutes" class="form-select">
                                <option value="30">30 minutes</option>
                                <option value="45">45 minutes</option>
                                <option value="60">60 minutes</option>
                                <option value="90">90 minutes</option>
                            </select>

                            <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>

                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="Optional appointment notes"></textarea>

                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button class="btn btn-primary" type="submit">
                            Schedule Appointment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}