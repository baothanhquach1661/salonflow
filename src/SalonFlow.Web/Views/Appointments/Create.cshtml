@model SalonFlow.Web.Models.CreateAppointmentViewModel

@{
    ViewData["Title"] = "New Appointment";
}

<div class="row justify-content-center">
    <div class="col-xl-9">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <p class="text-primary fw-semibold mb-1">
                    APPOINTMENTS
                </p>

                <h1 class="h2 fw-bold mb-1">
                    New Appointment
                </h1>

                <p class="text-secondary mb-0">
                    Schedule a service for a customer.
                </p>
            </div>

            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                Back to Dashboard
            </a>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Appointments" asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label"></label>

                            <input asp-for="CustomerName" class="form-control" placeholder="Enter customer name" />

                            <span asp-validation-for="CustomerName" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>

                            <input asp-for="PhoneNumber" class="form-control" placeholder="(555) 555-5555" />

                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ServiceId" class="form-label"></label>

                            <select asp-for="ServiceId" class="form-select">
                                <option value="">
                                    Select a service
                                </option>

                                @foreach (var service in Model.AvailableServices)
                                {
                                    <option value="@service.Id">
                                        @($"{service.Name} — {service.DurationMinutes} min — {service.Price:C}")
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="ServiceId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StaffMemberId" class="form-label"></label>

                            <select asp-for="StaffMemberId" class="form-select">
                                <option value="">
                                    Any available staff
                                </option>

                                @foreach (var staffMember in Model.AvailableStaffMembers)
                                {
                                    <option value="@staffMember.Id">
                                        @staffMember.Name
                                    </option>
                                }
                            </select>

                            <span asp-validation-for="StaffMemberId" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="StartsAtLocal" class="form-label"></label>

                            <input asp-for="StartsAtLocal" type="datetime-local" class="form-control" />

                            <span asp-validation-for="StartsAtLocal" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Notes" class="form-label"></label>

                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="Optional appointment notes"></textarea>

                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Cancel
                        </a>

                        <button class="btn btn-primary" type="submit">
                            Schedule Appointment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}