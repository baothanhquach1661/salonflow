@using SalonFlow.Domain.Appointments
@model SalonFlow.Web.Models.DashboardViewModel


@{
    ViewData["Title"] = "Dashboard";
}
@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-5">
    <div>
        <p class="text-primary fw-semibold mb-1">SALONFLOW</p>
        <h1 class="display-6 fw-bold mb-2">Salon Dashboard</h1>
        <p class="text-secondary mb-0">
            Manage today's appointments and customer flow.
        </p>
    </div>

    <a asp-controller="Appointments" asp-action="Create" class="btn btn-primary btn-lg">
        + New Appointment
    </a>
</div>

<div class="row g-4 mb-5">
    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 border-start border-primary border-4 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-2">Today's Appointments</p>
                <p class="display-5 fw-bold mb-0">
                    @Model.TodaysAppointmentCount
                </p>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 border-start border-warning border-4 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-2">Waiting</p>
                <p class="display-5 fw-bold mb-0">
                    @Model.WaitingCount
                </p>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 border-start border-success border-4 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-2">In Service</p>
                <p class="display-5 fw-bold mb-0">
                    @Model.InServiceCount
                </p>
            </div>
        </div>
    </div>

    <div class="col-sm-6 col-xl-3">
        <div class="card h-100 border-0 border-start border-info border-4 shadow-sm">
            <div class="card-body">
                <p class="text-secondary mb-2">Available Staff</p>
                <p class="display-5 fw-bold mb-0">0</p>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
        <h2 class="h5 mb-0">Today's Schedule</h2>

        <a asp-controller="Appointments" asp-action="Index" class="btn btn-sm btn-outline-primary">
            View All
        </a>
    </div>

    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Time</th>
                    <th>Customer</th>
                    <th>Service</th>
                    <th>Staff</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.TodaysAppointments.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-5">
                            No appointments scheduled for today.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.TodaysAppointments)
                    {
                        var statusText = item.Appointment.Status switch
                        {
                            AppointmentStatus.CheckedIn => "Checked In",
                            AppointmentStatus.InService => "In Service",
                            _ => item.Appointment.Status.ToString()
                        };

                        var badgeClass = item.Appointment.Status switch
                        {
                            AppointmentStatus.Scheduled => "bg-primary",
                            AppointmentStatus.CheckedIn => "bg-warning text-dark",
                            AppointmentStatus.InService => "bg-success",
                            AppointmentStatus.Completed => "bg-secondary",
                            AppointmentStatus.Cancelled => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td>
                                @(item.Appointment.StartsAtUtc
                                    .ToLocalTime()
                                    .ToString("h:mm tt"))
                            </td>
                            <td>@item.CustomerName</td>
                            <td>@item.ServiceName</td>
                            <td>@(item.StaffMemberName ?? "Any staff")</td>
                            <td>
                                <span class="badge @badgeClass">
                                    @statusText
                                </span>
                            </td>
                            <td>
                                <div class="d-flex gap-2">
                                    @if (item.Appointment.Status == AppointmentStatus.Scheduled)
                                    {
                                        <form asp-controller="Appointments" asp-action="CheckIn" asp-route-id="@item.Appointment.Id"
                                              method="post">
                                            <button type="submit" class="btn btn-sm btn-warning">
                                                Check In
                                            </button>
                                        </form>

                                        <form asp-controller="Appointments" asp-action="Cancel" asp-route-id="@item.Appointment.Id"
                                              method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Cancel this appointment?');">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else if (item.Appointment.Status == AppointmentStatus.CheckedIn)
                                    {
                                        <form asp-controller="Appointments" asp-action="StartService"
                                              asp-route-id="@item.Appointment.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-success">
                                                Start Service
                                            </button>
                                        </form>

                                        <form asp-controller="Appointments" asp-action="Cancel" asp-route-id="@item.Appointment.Id"
                                              method="post">
                                            <button type="submit" class="btn btn-sm btn-outline-danger"
                                                    onclick="return confirm('Cancel this appointment?');">
                                                Cancel
                                            </button>
                                        </form>
                                    }
                                    else if (item.Appointment.Status == AppointmentStatus.InService)
                                    {
                                        <form asp-controller="Appointments" asp-action="Complete"
                                              asp-route-id="@item.Appointment.Id" method="post">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                Complete
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">—</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>