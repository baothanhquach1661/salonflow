@model IReadOnlyList<SalonFlow.Domain.StaffMembers.StaffMember>

@{
    ViewData["Title"] = "Staff Members";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <p class="text-primary fw-semibold mb-1">SALONFLOW</p>
        <h1 class="h2 fw-bold mb-1">Staff Members</h1>
        <p class="text-secondary mb-0">
            Manage the salon team and availability.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        + New Staff Member
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success">
        @message
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        @if (Model.Count == 0)
        {
            <div class="text-center text-secondary py-5">
                No staff members have been added.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Name</th>
                            <th>Phone</th>
                            <th>Email</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var staffMember in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @staffMember.Name
                                </td>
                                <td>
                                    @(staffMember.PhoneNumber ?? "—")
                                </td>
                                <td>
                                    @(staffMember.Email ?? "—")
                                </td>
                                <td>
                                    <span
                                        class="badge @(staffMember.IsActive
                                                                                                                                                                    ? "bg-success"
                                                                                                                                                                    : "bg-secondary")">
                                        @(staffMember.IsActive
                                            ? "Active"
                                            : "Inactive")
                                    </span>
                                </td>
                                <td>
                                    @if (staffMember.IsActive)
                                    {
                                        <form asp-action="Deactivate" asp-route-id="@staffMember.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Deactivate
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Activate" asp-route-id="@staffMember.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-success">
                                                Activate
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>